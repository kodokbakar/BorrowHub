{
  "name": "borrowhub",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "bun run --filter @borrowhub/web dev",
    "build:web": "bun run --filter @borrowhub/web build",
    "typecheck:web": "bun run --filter @borrowhub/web typecheck"
  }
}