{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://borrowhub.dev/contracts/events/envelope.schema.json",
  "title": "BorrowHub Domain Event Envelope",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "source",
    "subject",
    "organization_id",
    "occurred_at",
    "correlation_id",
    "causation_id",
    "data"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
    },
    "event_version": {
      "type": "integer",
      "minimum": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "organization_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object"
    }
  },
  "additionalProperties": true
}