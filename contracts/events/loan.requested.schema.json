{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://borrowhub.dev/contracts/events/loan.requested.schema.json",
  "title": "BorrowHub Loan Requested Event",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "source",
    "subject",
    "organization_id",
    "occurred_at",
    "correlation_id",
    "causation_id",
    "data"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "const": "loan.requested"
    },
    "event_version": {
      "type": "integer",
      "minimum": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "organization_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object",
      "required": [
        "loan_request_id",
        "item_id",
        "requester_user_id",
        "quantity",
        "start_time",
        "end_time",
        "purpose"
      ],
      "properties": {
        "loan_request_id": {
          "type": "string"
        },
        "item_id": {
          "type": "string"
        },
        "requester_user_id": {
          "type": "string"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        },
        "start_time": {
          "type": "string",
          "format": "date-time"
        },
        "end_time": {
          "type": "string",
          "format": "date-time"
        },
        "purpose": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
